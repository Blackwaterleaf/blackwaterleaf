FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
COPY patches ./patches
RUN pnpm install --frozen-lockfile
COPY dist ./dist
COPY drizzle ./drizzle
COPY shared ./shared
COPY server ./server
COPY client ./client
COPY tsconfig.json ./tsconfig.json
RUN useradd --system --uid 10001 --create-home bwl && mkdir -p /var/lib/blackwaterleaf/media && chown -R bwl:bwl /app /var/lib/blackwaterleaf
USER bwl
EXPOSE 3000
CMD ["node", "dist/index.js"]
