# Store this file as /etc/blackwaterleaf/production.env with mode 600.
# Never commit the populated file.
JWT_SECRET=<new-random-secret>
BWL_MEDIA_SIGNING_SECRET=<new-random-secret>
BWL_SELF_HOSTED_AUTH_ONLY=true
AUTH_FROM_EMAIL=<verified-blackwaterleaf-domain-sender>
AUTH_REPLY_TO_EMAIL=<blackwaterleaf@gmail.com>
AUTH_PUBLIC_ORIGIN=https://blackwaterleaf.com
RESEND_API_KEY=<blackwaterleaf-resend-key>
GOOGLE_OAUTH_CLIENT_ID=<blackwaterleaf-google-client-id>
GOOGLE_OAUTH_CLIENT_SECRET=<blackwaterleaf-google-client-secret>
GOOGLE_OAUTH_REDIRECT_URI=https://blackwaterleaf.com/api/oauth/google/callback
AI_PROVIDER=ionos
IONOS_AI_API_URL=https://openai.inference.de-txl.ionos.com
IONOS_AI_API_KEY=<ionos-ai-key>
IONOS_AI_MODEL=Qwen/Qwen3.5-9B
STRIPE_SECRET_KEY=<stripe-key>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-secret>
BWL_DB_PASSWORD=<strong-database-password>
BWL_DB_ROOT_PASSWORD=<strong-database-root-password>
RELEASE_ID=<release-id>
