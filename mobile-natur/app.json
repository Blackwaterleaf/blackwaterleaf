{
  "expo": {
    "name": "BlackWaterLeaf",
    "slug": "blackwater-agent",
    "version": "1.0.14",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "blackwaterleaf",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.blackwaterleaf"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#031108",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.blackwaterleaf",
      "versionCode": 14,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "BlackWaterLeaf verwendet die Kamera nur, wenn du einen privaten Naturmoment aufnimmst.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BlackWaterLeaf benötigt Zugriff auf ausgewählte Fotos nur, wenn du einen privaten Naturmoment hochlädst.",
          "cameraPermission": "BlackWaterLeaf verwendet die Kamera nur, wenn du einen privaten Naturmoment aufnimmst."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BlackWaterLeaf verwendet deinen Standort nur für das aktuelle Außenwetter und speichert keine Koordinaten."
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "apiOrigin": "https://blackwaterleaf.com",
      "nativePrivateFlows": "requires_registered_mobile_oauth",
      "eas": {
        "projectId": "49fead16-1e34-463b-9b18-a9bc4e601808"
      }
    },
    "owner": "blackwaterleaf"
  }
}
