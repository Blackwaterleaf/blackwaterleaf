{
  "expo": {
    "name": "BlackWaterLeaf",
    "slug": "bwl",
    "version": "1.0.20",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "blackwaterleaf",
    "userInterfaceStyle": "dark",
    "runtimeVersion": { "policy": "appVersion" },
    "updates": {
      "url": "https://u.expo.dev/40ef1859-d5f9-484d-89e9-046333b708f4",
      "checkAutomatically": "ON_LOAD"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.blackwaterleaf"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#031108",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.blackwaterleaf",
      "versionCode": 20,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "BlackWaterLeaf verwendet die Kamera nur, wenn du einen privaten Naturmoment aufnimmst.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BlackWaterLeaf benötigt Zugriff auf ausgewählte Fotos nur, wenn du einen privaten Naturmoment hochlädst.",
          "cameraPermission": "BlackWaterLeaf verwendet die Kamera nur, wenn du einen privaten Naturmoment aufnimmst."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BlackWaterLeaf verwendet deinen Standort nur für das aktuelle Außenwetter und speichert keine Koordinaten."
        }
      ],
      "expo-sharing",
      "expo-video"
    ],
    "extra": {
      "apiOrigin": "https://blackwaterleaf.com",
      "nativePrivateFlows": "requires_registered_mobile_oauth",
      "eas": {
        "projectId": "40ef1859-d5f9-484d-89e9-046333b708f4"
      }
    },
    "owner": "blackwaterleaf2s-team"
  }
}
